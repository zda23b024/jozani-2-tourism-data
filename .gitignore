# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
.venv/

# Secrets
.env
!.env.example

# Browser session/cache
browser/*_browser_profile/
!browser/.gitkeep
*.sqlite
*.sqlite3
*.db

# Generated output
output/csv/*
output/json/*
output/debug/
output/logs/
output/*.png
output/*.html
!output/csv/.gitkeep
!output/json/.gitkeep

# Local temp files
.tmp/
tmp/
*.tmp
*.log
*.har
storage_state*.json
cookies*.json
session*.json

# Excel lock/temp files
~$*.xlsx

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
vscode_backup/
.idea/
