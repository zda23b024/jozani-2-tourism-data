POSTGRES_DB=zanzibar_booking_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password

PGHOST=db
PGPORT=5432
PGDATABASE=zanzibar_booking_data
PGUSER=postgres
PGPASSWORD=change_this_password

# Docker uses PGHOST=db and HEADLESS=true.
# For running directly on Windows outside Docker, use PGHOST=localhost and HEADLESS=false.

# Optional: use this instead of the PGHOST/PGDATABASE/PGUSER/PGPASSWORD fields.
# DATABASE_URL=postgresql://postgres:change_this_password@localhost:5432/zanzibar_booking_data

HEADLESS=true
ALLOW_SCHEMA_REBUILD=false
DASHBOARD_DB_USER=postgres
DASHBOARD_DB_PASSWORD=change_this_password
DASHBOARD_REFRESH_SECONDS=30
HOTEL_REVIEW_CONCURRENCY=1
ATTRACTION_REVIEW_CONCURRENCY=1
MAX_REVIEW_PAGES_PER_ATTRACTION=unlimited
BOOKING_ATTRACTION_REVIEW_PLACE_LIMIT=unlimited

TRIPADVISOR_GEO_ID=482884
TRIPADVISOR_LOCATION_SLUG=Zanzibar_Island_Zanzibar_Archipelago
MAX_TRIPADVISOR_HOTEL_PAGES=unlimited
MAX_TRIPADVISOR_PLACE_PAGES=unlimited
MAX_TRIPADVISOR_REVIEW_PAGES=unlimited
TRIPADVISOR_REVIEW_PLACE_LIMIT=unlimited
TRIPADVISOR_RESULTS_PER_PAGE=30
TRIPADVISOR_REVIEWS_PER_PAGE=10
TRIPADVISOR_RESTAURANT_REVIEWS_PER_PAGE=15
TRIPADVISOR_REVIEW_CONCURRENCY=1
TRIPADVISOR_CATALOG_TEST_FIRST_PAGE_ONLY=false
TRIPADVISOR_GRAPHQL_URL=https://www.tripadvisor.com/data/graphql/ids
TRIPADVISOR_HOTEL_REVIEWS_QUERY_ID=ef3cb4f569f27e43
TRIPADVISOR_REVIEW_GRAPHQL_ENABLED=true
TRIPADVISOR_REVIEW_GRAPHQL_URL=https://www.tripadvisor.com/data/graphql/ids
TRIPADVISOR_REVIEW_GRAPHQL_QUERY_ID=ef3cb4f569f27e43
TRIPADVISOR_REVIEW_LANGUAGE=en
TRIPADVISOR_HOTEL_REVIEW_LANGUAGE_FILTER=all
TRIPADVISOR_REVIEW_PHOTOS_PER_REVIEW=3
TRIPADVISOR_HOTEL_GRAPHQL_ENABLED=true
TRIPADVISOR_HOTEL_GRAPHQL_URL=https://www.tripadvisor.com/data/graphql/ids
TRIPADVISOR_HOTEL_GRAPHQL_QUERY_ID=f101de74ce917363
TRIPADVISOR_HOTEL_SORT=BEST_VALUE
TRIPADVISOR_HOTEL_PRICING_MODE=ALL_IN_FULL_STAY
TRIPADVISOR_ATTRACTIONS_GRAPHQL_ENABLED=true
TRIPADVISOR_ATTRACTIONS_GRAPHQL_URL=https://www.tripadvisor.com/data/graphql/ids
TRIPADVISOR_ATTRACTIONS_GRAPHQL_QUERY_ID=ec9722f86b4550e3
